AI_API_KEY=""
AI_MODEL=""
MARKET_API_URL=""
MARKET_API_KEY=""
MARKET_COMMERCIAL_RIGHTS="false"

NEWS_PROVIDER="demo"
NEWS_API_URL=""
NEWS_API_KEY=""
NEWS_COMMERCIAL_RIGHTS="false"
CALENDAR_PROVIDER="demo"
CALENDAR_API_URL=""
CALENDAR_API_KEY=""
CALENDAR_COMMERCIAL_RIGHTS="false"

# Shared backend engine. Keep demo until local connectivity is verified.
# MARKET_PROVIDER="multi"
MARKET_DATA_SCOPE="local"
MARKET_ENGINE_PORT="3110"
MARKET_ENGINE_TOKEN=""
MARKET_PROVIDER_PRIORITY="binance,coinbase,kraken,coingecko,twelvedata"
MARKET_POLL_MS="15000"
MARKET_STALE_MS="60000"
MARKET_REQUESTS_PER_MINUTE="60"
BINANCE_WEBSOCKET_ENABLED="false"
COINGECKO_API_KEY=""
TWELVE_DATA_API_KEY=""
# Optional comma-separated canonical pair allowlist; unset uses the approved registry.
# MARKET_INSTRUMENTS="BTC/USD,BTC/USDT,ETH/USD,ETH/USDT,SOL/USD,SOL/USDT"
# Commercial scope is denied by default. See docs/MARKET-DATA.md for evidence requirements.
MARKET_PROVIDER_RIGHTS='{}'
# Optional server-side evaluation in the existing market job. Local administrators
# only; never merged into subscriber quotes, analytics or exports. No new daemon.
BIQUOTE_EVALUATION_ENABLED="false"
GOLD_API_EVALUATION_ENABLED="false"
# Commercial deterministic reports/price alerts also require analysis:true in each
# provider's evidenced rights entry. This is separate from external AI and export.

# Credential-gated real content; no account, purchase or rights are implied.
# NEWS_PROVIDER="finnhub"
NEWS_CATEGORIES="general,crypto,forex"
NEWS_RIGHTS_REFERENCE=""
NEWS_AI_RIGHTS="false"
# CALENDAR_PROVIDER="tradingeconomics"
CALENDAR_RIGHTS_REFERENCE=""
CALENDAR_AI_RIGHTS="false"
# Costs 100 Twelve Data credits/request, Enterprise business entitlement; opt-in only.
TWELVE_DATA_SCHEDULE_ENABLED="false"

# Per-provider conservative request limits; set below your actual plan/shared-IP limits.
MARKET_PROVIDER_BUDGETS='{"coingecko":5,"twelvedata":8}'

NEWS_EXPORT_RIGHTS="false"
CALENDAR_EXPORT_RIGHTS="false"

# Reviewed free adapters: keyless, with visible source attribution.
# NEWS_PROVIDER="capitaldatawire"
# CALENDAR_PROVIDER="financecalendar"
# SEC is disabled unless an identified contact User-Agent is configured.
SEC_ENABLED="false"
SEC_USER_AGENT=""
# Example format: Organisation Application contact@your-domain.tld
# News/calendar/fundamentals collect hourly; request handlers only read caches.
# Provider enable/disable controls persist through the authenticated admin UI.

# Stable source recovery: healthy fallback dwell; stale sources bypass dwell.
MARKET_MIN_DWELL_MS="300000"
MARKET_RECOVERY_PROBE_MS="30000"
MARKET_RECOVERY_SUCCESSES="3"
